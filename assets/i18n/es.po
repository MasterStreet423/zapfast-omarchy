msgid "Reset link"
msgstr "Restablecer enlace"

#: src/ui/dialogs.rs:1610
msgid "Remove from the group?"
msgstr "¿Eliminar del grupo?"

#: src/ui/dialogs.rs:1616
#, rust-format
msgid ""
"{name} will no longer receive messages from {group}. You can add them again "
"later."
msgstr ""
"{name} ya no recibirá mensajes de {group}. Puedes volver a agregar a esta "
"persona más tarde."

