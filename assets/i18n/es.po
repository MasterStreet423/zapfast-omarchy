msgstr ""
"«Sistema» es la fuente de la interfaz de tu escritorio. Inter se ve igual en "
"todos los computadores."

#: src/ui/settings.rs:363
msgid "Wallpaper"
msgstr "Fondo de pantalla"

#: src/ui/settings.rs:367 src/app.rs:3707 src/ui/image_preview.rs:248
