msgstr "Idioma"

#: src/ui/settings.rs:429 src/ui/settings.rs:1901
msgid "Custom title bar"
msgstr "Barra de título personalizada"

#: src/ui/settings.rs:432
msgid ""
"Draw ZapFast's own title bar and window buttons instead of the desktop's."
msgstr ""
"Dibuja la barra de título y los botones de ventana propios de ZapFast en "
"lugar de los del escritorio."

#: src/ui/settings.rs:440
msgid "Enter sends"
msgstr "Enter envía"

#: src/ui/settings.rs:441
msgid "When off, Ctrl+Enter sends."
msgstr "Si está desactivado, se envía con Ctrl+Intro."

#: src/ui/settings.rs:445
msgid "Download files automatically"
msgstr "Descargar archivos automáticamente"

#: src/ui/settings.rs:448
