msgstr "Guardar"

#: src/ui/settings.rs:1215
msgid "A native WhatsApp client built with Rust, egui, and whatsapp-rust."
msgstr "Un cliente nativo de WhatsApp hecho con Rust, egui y whatsapp-rust."

#: src/ui/settings.rs:1226
#, rust-format
msgid "Update to {version}"
msgstr "Actualizar a {version}"

#: src/ui/settings.rs:1304
msgid "Mention sound"
msgstr "Sonido de mención"

#: src/ui/settings.rs:1307
msgid "Played when someone mentions you or replies to you in a group."
msgstr "Suena cuando alguien te menciona o te responde en un grupo."

#: src/ui/settings.rs:1312
msgid "Message sound"
msgstr "Sonido de mensajes"

#: src/ui/settings.rs:1313
msgid "Played for new messages in chats and groups."
